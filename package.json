{
  "name": "phone-comparator-2026",
  "version": "2.0.0",
  "private": true,
  "description": "Comparaison a l'echelle reelle relative des ecrans de smartphones, catalogue externalise en JSON",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "node": "node scripts/verifier-node.mjs",
    "build": "pnpm run node && next build",
    "start": "next start",
    "types": "tsc --noEmit",
    "check": "pnpm run types && pnpm run build"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 iOS versions"
  ],
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "next": "^16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^7.0.2"
  }
}
